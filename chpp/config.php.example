<?php

include __DIR__ . '/../config.php';

// chpp secret keys, KEEP THESE SECRET!
define('APP_CONSUMERKEY', '');
define('APP_CONSUMERSECRET', '');

// prevent flooding
define('MIN_REFRESH_SECONDS', 60);

// cookies (for permanent authorization)
define('COOKIE_DOMAIN', '');
define('COOKIE_PATH', '');
define('COOKIE_SECURE', true);
define('COOKIE_EXPIRE_TIME', time() + (180 * 24 * 60 * 60));
define('COOKIE_OPTIONS', [
    'expires'  => COOKIE_EXPIRE_TIME,
    'path'     => COOKIE_PATH,
    'domain'   => COOKIE_DOMAIN,
    'secure'   => COOKIE_SECURE,
    'httponly'  => true,
    'samesite' => 'Lax',
]);

// cookie encryption keys (generate with: php -r "echo 'define(\"COOKIE_ENCRYPTION_KEY\", \"' . bin2hex(random_bytes(32)) . '\");' . PHP_EOL . 'define(\"COOKIE_HMAC_KEY\", \"' . bin2hex(random_bytes(32)) . '\");' . PHP_EOL;")
define('COOKIE_ENCRYPTION_KEY', '');
define('COOKIE_HMAC_KEY', '');

function getPhtConfig(array $extra = []): array
{
    return array_merge([
        'CONSUMER_KEY' => APP_CONSUMERKEY,
        'CONSUMER_SECRET' => APP_CONSUMERSECRET,
    ], $extra);
}