{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["js/*.js"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"correctness": {
				"noUndeclaredVariables": "warn",
				"noUnreachable": "error"
			},
			"suspicious": {
				"noDuplicateCase": "error"
			}
		}
	},
	"assist": {
		"enabled": false
	},
	"javascript": {
		"globals": ["$", "jQuery", "ActiveXObject", "Enumerator"]
	}
}
