{
  "name": "staminia",
  "version": "13.9.29",
  "description": "Hattrick's first substitutions calculator tool",
  "private": true,
  "scripts": {
    "build": "esbuild src/engine.js src/main.js src/plugins.js --outdir=js --target=es2015 --format=iife",
    "watch": "esbuild src/engine.js src/main.js src/plugins.js --outdir=js --target=es2015 --format=iife --watch",
    "lint": "run-s lint:js lint:css lint:php",
    "lint:js": "biome check src/",
    "lint:css": "stylelint 'css/**/*.css'",
    "lint:php": "composer lint",
    "prepare": "husky"
  },
  "keywords": [
    "hattrick",
    "stamina",
    "substitutions",
    "calculator"
  ],
  "license": "BSD-2-Clause",
  "lint-staged": {
    "src/**/*.js": "biome check --write",
    "css/**/*.css": "stylelint --fix",
    "*.php": "vendor/bin/php-cs-fixer fix --dry-run --config=.php-cs-fixer.dist.php"
  },
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "esbuild": "^0.27.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
