{
  "name": "staminia",
  "version": "13.9.29",
  "description": "Hattrick's first substitutions calculator tool",
  "private": true,
  "scripts": {
    "build": "run-s build:js build:css",
    "build:js": "esbuild src/index.js --bundle --outfile=dist/staminia.min.js --format=iife --target=es2015 --minify --define:this=window",
    "build:css": "esbuild src/styles.css --bundle --outfile=dist/staminia.min.css --minify --external:*.png",
    "build:dev": "run-s build:dev:js build:dev:css",
    "build:dev:js": "esbuild src/index.js --bundle --outfile=dist/staminia.min.js --format=iife --target=es2015 --define:this=window",
    "build:dev:css": "esbuild src/styles.css --bundle --outfile=dist/staminia.min.css --external:*.png",
    "watch": "run-p watch:js watch:css",
    "watch:js": "esbuild src/index.js --bundle --outfile=dist/staminia.min.js --format=iife --target=es2015 --define:this=window --watch",
    "watch:css": "esbuild src/styles.css --bundle --outfile=dist/staminia.min.css --external:*.png --watch",
    "lint": "run-s lint:js lint:css lint:php",
    "lint:js": "biome check src/",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:php": "composer lint",
    "prepare": "husky"
  },
  "keywords": [
    "hattrick",
    "stamina",
    "substitutions",
    "calculator"
  ],
  "license": "BSD-2-Clause",
  "lint-staged": {
    "src/**/*.js": "biome check --write",
    "src/**/*.css": "stylelint --fix",
    "*.php": "vendor/bin/php-cs-fixer fix --dry-run --config=.php-cs-fixer.dist.php"
  },
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "esbuild": "^0.27.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "5.3.3",
    "jquery": "3.7.1"
  }
}
